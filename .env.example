# Copy this file to .env and fill in your own values. Never commit .env.

APP_NAME=MalwareGuard

# Web server started by START_MALICIOUSPROJECT.bat.
# 127.0.0.1 = only this computer can open the dashboard (safest default).
# To let agents on other PCs connect, set APP_HOST to this server's LAN IP
# (for example 192.168.1.10), or 0.0.0.0 for every network interface.
APP_HOST=10.83.54.4
APP_PORT=8000

# MySQL Server (manage it with MySQL Workbench). Create a dedicated account
# instead of using root; see README.md.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=malwareguard
DB_USER=malwareguard_app
DB_PASS=

# Gmail SMTP for verification codes. MAIL_PASS must be a Google App Password,
# not your normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-sender@gmail.com
MAIL_PASS=your-google-app-password
MAIL_FROM_NAME=MalwareGuard

# Optional intelligence. Leave empty to run on static rules only.
# VirusTotal receives only SHA-256 hashes, never file contents.
VIRUSTOTAL_API_KEY=
VT_REQUESTS_PER_MINUTE=4
VT_REQUESTS_PER_DAY=500
VT_CACHE_HOURS=24
OPENAI_API_KEY=

# Endpoint agents
ENROLLMENT_TOKEN_TTL_HOURS=24
AGENT_HEARTBEAT_SECONDS=30
AGENT_OFFLINE_AFTER_SECONDS=90
AGENT_MAX_UPLOAD_MB=50
AGENT_REQUESTS_PER_MINUTE=120
# true = every new file in a monitored folder is scanned automatically
# (the agent uploads it to this server). false = administrators choose.
AUTO_SCAN_NEW_FILES=false

# Only used once by `php super_admin/create_account.php`; remove afterwards.
SUPER_ADMIN_PASSWORD=
